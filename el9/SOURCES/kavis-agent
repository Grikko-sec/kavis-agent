#!/usr/bin/env python3
"""kavis-agent - 취약점 점검 플랫폼 수집 에이전트

서버는 아무것도 판정하지 않는다. 이 에이전트는 정해진 원문(설정 파일,
패키지 목록, dnf 보안 업데이트 목록 등)만 그대로 수집해 플랫폼의
/api/agent/ingest.php 로 전송한다. 취약 여부 판정은 전부 서버 쪽
(parse_rules 테이블)에서 이루어진다 — 판정 기준이 바뀌어도 에이전트를
재배포할 필요가 없다.
"""
import argparse
import configparser
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import urllib.error
import urllib.request

CONFIG_PATH = "/etc/kavis-agent/config.ini"
MAX_ITEM_BYTES = 190_000  # 서버 측 200KB 제한보다 여유를 둔다
TIMEOUT_SECONDS = 20


def log(msg: str) -> None:
    print(f"[kavis-agent] {msg}", file=sys.stderr, flush=True)


def read_config() -> dict:
    cp = configparser.ConfigParser()
    if not cp.read(CONFIG_PATH):
        log(f"설정 파일을 읽을 수 없습니다: {CONFIG_PATH}")
        sys.exit(1)
    if "agent" not in cp:
        log("설정 파일에 [agent] 섹션이 없습니다.")
        sys.exit(1)
    section = cp["agent"]
    server_url = section.get("server_url", "").rstrip("/")
    token = section.get("token", "").strip()
    enroll_key = section.get("enroll_key", "").strip()
    if not server_url or (not token and not enroll_key):
        log("server_url이 비어있거나, token/enroll_key가 둘 다 비어있습니다. "
            "/etc/kavis-agent/config.ini 를 확인하세요.")
        sys.exit(1)
    return {
        "server_url": server_url,
        "token": token,
        "enroll_key": enroll_key,
        "verify_tls": section.getboolean("verify_tls", fallback=True),
        "timeout": section.getint("timeout", fallback=TIMEOUT_SECONDS),
    }


def make_ssl_context(url: str, verify_tls: bool):
    if url.startswith("https://") and not verify_tls:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        return ctx
    return None


def enroll(config: dict) -> str:
    """공용 등록 키로 자산을 자동 등록하고, 발급받은 전용 토큰을 설정 파일에 저장한다."""
    url = f"{config['server_url']}/api/agent/enroll.php"
    payload = {"hostname": socket.gethostname()}
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        method="POST",
        headers={
            "Authorization": f"Bearer {config['enroll_key']}",
            "Content-Type": "application/json",
            "User-Agent": "kavis-agent/0.4.1",
        },
    )
    ctx = make_ssl_context(url, config["verify_tls"])
    try:
        with urllib.request.urlopen(req, timeout=config["timeout"], context=ctx) as resp:
            result = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        log(f"자동 등록 실패 ({e.code}): {e.read().decode('utf-8', errors='replace')}")
        sys.exit(1)
    except urllib.error.URLError as e:
        log(f"자동 등록 연결 실패: {e.reason}")
        sys.exit(1)

    token = result.get("token", "")
    if not token:
        log(f"자동 등록 응답에 토큰이 없습니다: {result}")
        sys.exit(1)

    saved = save_token(token)
    status = "설정 파일에 저장했습니다" if saved else "설정 파일 저장에 실패했습니다 — 이번 실행에만 사용되고 다음 실행에서 다시 등록됩니다"
    log(f"자동 등록 완료 (asset_id={result.get('asset_id')}, "
        f"{'신규 생성' if result.get('created') else '기존 자산 재사용'}) — 토큰을 {status}.")
    return token


def save_token(token: str) -> bool:
    """CONFIG_PATH의 token = ... 줄만 교체한다. 없으면 [agent] 섹션 끝에 추가한다.
    실제로 저장됐는지 여부를 반환한다 — 호출자가 성공 여부를 로그에 정확히 남길 수 있도록."""
    try:
        with open(CONFIG_PATH, "r") as f:
            lines = f.readlines()
    except OSError as e:
        log(f"설정 파일을 읽을 수 없어 토큰을 저장하지 못했습니다: {e}")
        return False

    pattern = re.compile(r"^\s*token\s*=.*$")
    replaced = False
    for i, line in enumerate(lines):
        if pattern.match(line):
            lines[i] = f"token = {token}\n"
            replaced = True
            break

    if not replaced:
        for i, line in enumerate(lines):
            if line.strip() == "[agent]":
                lines.insert(i + 1, f"token = {token}\n")
                replaced = True
                break

    if not replaced:
        lines.append(f"\n[agent]\ntoken = {token}\n")

    try:
        with open(CONFIG_PATH, "w") as f:
            f.writelines(lines)
        return True
    except OSError as e:
        log(f"설정 파일에 토큰을 저장하지 못했습니다: {e}")
        return False


def cmd_configure(args) -> None:
    """비대화형으로 config.ini를 작성한다. 프로비저닝 자동화(Ansible/cloud-init 등)용.
    각 값은 --플래그 또는 KAVIS_* 환경변수로 줄 수 있다 (플래그가 우선)."""
    server_url = args.server_url or os.environ.get("KAVIS_SERVER_URL", "")
    enroll_key = args.enroll_key or os.environ.get("KAVIS_ENROLL_KEY", "")
    token = args.token or os.environ.get("KAVIS_TOKEN", "")
    verify_tls = "true" if args.verify_tls else "false"

    if not server_url:
        log("--server-url (또는 KAVIS_SERVER_URL)이 필요합니다.")
        sys.exit(2)
    if not enroll_key and not token:
        log("--enroll-key 또는 --token (혹은 해당 환경변수) 중 하나는 필요합니다.")
        sys.exit(2)

    content = (
        "[agent]\n"
        f"server_url = {server_url.rstrip('/')}\n"
        f"enroll_key = {enroll_key}\n"
        f"token = {token}\n"
        f"verify_tls = {verify_tls}\n"
        f"timeout = {args.timeout}\n"
    )
    try:
        with open(CONFIG_PATH, "w") as f:
            f.write(content)
        os.chmod(CONFIG_PATH, 0o640)
    except OSError as e:
        log(f"설정 파일을 쓰지 못했습니다: {e}")
        sys.exit(1)

    log(f"{CONFIG_PATH} 작성 완료.")


def run_cmd(args: list, timeout: int = 30) -> str:
    try:
        result = subprocess.run(
            args, capture_output=True, text=True, timeout=timeout, check=False,
            stdin=subprocess.DEVNULL,  # 절대 대화형 프롬프트에서 멈추지 않도록
        )
        return result.stdout
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        log(f"명령 실행 실패 ({' '.join(args)}): {e}")
        return ""


def read_file(path: str) -> str:
    try:
        with open(path, "r", errors="replace") as f:
            return f.read()
    except OSError as e:
        log(f"파일 읽기 실패 ({path}): {e}")
        return ""


def truncate(text: str) -> str:
    data = text.encode("utf-8", errors="replace")
    if len(data) <= MAX_ITEM_BYTES:
        return text
    return data[:MAX_ITEM_BYTES].decode("utf-8", errors="ignore")


def collect() -> dict:
    items = {}

    sshd = read_file("/etc/ssh/sshd_config")
    if sshd:
        items["sshd_config"] = truncate(sshd)

    os_release = read_file("/etc/os-release")
    if os_release:
        items["os_release"] = truncate(os_release)

    packages = run_cmd(["rpm", "-qa", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n"])
    if packages:
        items["packages"] = truncate(packages)

    ports = run_cmd(["ss", "-tlnp"])
    if ports:
        items["listening_ports"] = truncate(ports)

    passwd = read_file("/etc/passwd")
    if passwd:
        items["passwd"] = truncate(passwd)

    # /etc/shadow는 내용이 아니라 권한·소유자만 — 해시도 유출 가능한 비밀값이라 절대 원문을 가져오지 않는다
    shadow_perm = run_cmd(["stat", "-c", "%a %U:%G %n", "/etc/shadow", "/etc/passwd"])
    if shadow_perm:
        items["shadow_perm"] = truncate(shadow_perm)

    login_defs = read_file("/etc/login.defs")
    if login_defs:
        items["login_defs"] = truncate(login_defs)

    pwquality_conf = read_file("/etc/security/pwquality.conf")
    if pwquality_conf:
        items["pwquality_conf"] = truncate(pwquality_conf)

    cron_parts = []
    for p in ("/etc/cron.allow", "/etc/cron.deny"):
        c = read_file(p)
        if c:
            cron_parts.append(f"# {p}\n{c}")
    root_crontab = run_cmd(["crontab", "-l", "-u", "root"])
    if root_crontab:
        cron_parts.append(f"# root crontab\n{root_crontab}")
    if cron_parts:
        items["cron_config"] = truncate("\n\n".join(cron_parts))

    # dnf가 없는 배포판(예: 구형 yum 계열)은 조용히 건너뛴다.
    # 저장소 메타데이터가 캐시되지 않은 첫 실행은 시간이 오래 걸릴 수 있어 타임아웃을 넉넉히 둔다.
    dnf_updates = run_cmd(
        ["dnf", "-y", "-q", "updateinfo", "list", "security", "--installed"], timeout=180
    )
    if dnf_updates:
        items["dnf_security_updates"] = truncate(dnf_updates)

    return {
        "agent_version": "0.4.1",
        "hostname": socket.gethostname(),
        "items": items,
        "inventory": collect_inventory(),
    }


def _to_int(s):
    try:
        return int(re.sub(r"\D", "", s or ""))
    except (ValueError, TypeError):
        return None


def collect_inventory() -> dict:
    """자산 인벤토리(식별/OS/하드웨어/네트워크) — 취약점 판정과 무관한 단순 사실 수집.
    판정이 아니라 사실 추출이므로, 원문이 아니라 구조화된 값으로 보낸다."""
    inv = {"fqdn": socket.getfqdn()}

    # ── 네트워크 ──
    ifaces, all_ips, all_macs = [], [], []
    ip_json = run_cmd(["ip", "-j", "addr", "show"])
    if ip_json:
        try:
            for link in json.loads(ip_json):
                name = link.get("ifname")
                if name == "lo":
                    continue
                mac = link.get("address")
                ips = [a["local"] for a in link.get("addr_info", []) if a.get("family") == "inet"]
                if mac:
                    all_macs.append(mac)
                all_ips.extend(ips)
                ifaces.append({"name": name, "mac": mac, "ips": ips})
        except (json.JSONDecodeError, KeyError, TypeError, AttributeError):
            pass
    inv["network_interfaces"] = ifaces
    inv["ip_addresses"] = all_ips
    inv["mac_addresses"] = all_macs

    dns_servers, domain = [], None
    for line in read_file("/etc/resolv.conf").splitlines():
        line = line.strip()
        if line.startswith("nameserver"):
            parts = line.split()
            if len(parts) >= 2:
                dns_servers.append(parts[1])
        elif (line.startswith("domain") or line.startswith("search")) and not domain:
            parts = line.split()
            if len(parts) >= 2:
                domain = parts[1]
    inv["dns_servers"] = dns_servers
    inv["domain"] = domain

    # ── 식별 (UUID) ──
    uuid = read_file("/sys/class/dmi/id/product_uuid").strip() or read_file("/etc/machine-id").strip()
    inv["machine_uuid"] = uuid or None

    # ── OS ──
    os_info = {}
    for line in read_file("/etc/os-release").splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            os_info[k.strip()] = v.strip().strip('"')
    inv["os_name"] = os_info.get("PRETTY_NAME") or os_info.get("NAME")
    inv["os_version"] = os_info.get("VERSION_ID") or os_info.get("VERSION")
    inv["os_arch"] = run_cmd(["uname", "-m"]).strip() or None
    inv["kernel_version"] = run_cmd(["uname", "-r"]).strip() or None

    # ── 하드웨어 (dmidecode -- 없거나 권한 부족하면 조용히 None) ──
    def dmi(field):
        v = run_cmd(["dmidecode", "-s", field]).strip()
        return v if v and not v.startswith("#") else None

    inv["manufacturer"] = dmi("system-manufacturer")
    inv["model"] = dmi("system-product-name")
    inv["serial_number"] = dmi("system-serial-number")
    inv["bios_version"] = dmi("bios-version")

    cpu_model = cpu_count = core_count = None
    for line in run_cmd(["lscpu"]).splitlines():
        if line.startswith("Model name:"):
            cpu_model = line.split(":", 1)[1].strip()
        elif line.startswith("Socket(s):"):
            cpu_count = _to_int(line.split(":", 1)[1])
        elif line.startswith("CPU(s):") and core_count is None:
            core_count = _to_int(line.split(":", 1)[1])
    inv["cpu_model"] = cpu_model
    inv["cpu_count"] = cpu_count
    inv["cpu_core_count"] = core_count

    mem_total_kb = None
    for line in read_file("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            mem_total_kb = _to_int(line.split(":", 1)[1])
            break
    inv["memory_mb"] = (mem_total_kb // 1024) if mem_total_kb else None

    disk_gb = None
    for line in run_cmd(["df", "-BG", "--total", "-x", "tmpfs", "-x", "devtmpfs"]).splitlines():
        if line.startswith("total"):
            parts = line.split()
            if len(parts) >= 2:
                disk_gb = _to_int(parts[1])

    inv["disk_total_gb"] = disk_gb

    virt = run_cmd(["systemd-detect-virt"]).strip()
    inv["virtualization_type"] = "physical" if virt == "none" else (virt or None)

    return inv


def send(config: dict, payload: dict) -> None:
    url = f"{config['server_url']}/api/agent/ingest.php"
    data = json.dumps(payload).encode("utf-8")

    req = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {config['token']}",
            "Content-Type": "application/json",
            "User-Agent": "kavis-agent/0.4.1",
        },
    )

    ctx = make_ssl_context(url, config["verify_tls"])

    try:
        with urllib.request.urlopen(req, timeout=config["timeout"], context=ctx) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            log(f"전송 성공 ({resp.status}): {body}")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        log(f"서버 응답 오류 ({e.code}): {body}")
        sys.exit(1)
    except urllib.error.URLError as e:
        log(f"연결 실패: {e.reason}")
        sys.exit(1)


def cmd_run(_args) -> None:
    config = read_config()
    if not config["token"]:
        config["token"] = enroll(config)

    payload = collect()
    log(f"{len(payload['items'])}개 항목 수집 완료, 전송 중...")
    send(config, payload)


def main() -> None:
    parser = argparse.ArgumentParser(prog="kavis-agent")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("run", help="수집 후 전송 (systemd timer가 호출)")

    p_conf = sub.add_parser("configure", help="config.ini를 비대화형으로 작성 (프로비저닝 자동화용)")
    p_conf.add_argument("--server-url", default="")
    p_conf.add_argument("--enroll-key", default="")
    p_conf.add_argument("--token", default="")
    p_conf.add_argument("--timeout", type=int, default=TIMEOUT_SECONDS)
    p_conf.add_argument("--verify-tls", dest="verify_tls", action="store_true", default=True)
    p_conf.add_argument("--no-verify-tls", dest="verify_tls", action="store_false")

    args = parser.parse_args()
    {"run": cmd_run, "configure": cmd_configure}[args.command](args)


if __name__ == "__main__":
    main()
