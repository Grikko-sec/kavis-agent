#!/usr/bin/env python3
"""kavis-agent - 취약점 점검 플랫폼 수집 에이전트

서버는 아무것도 판정하지 않는다. 이 에이전트는 정해진 원문(설정 파일,
패키지 목록, dnf 보안 업데이트 목록 등)만 그대로 수집해 플랫폼의
/api/agent/ingest.php 로 전송한다. 취약 여부 판정은 전부 서버 쪽
(parse_rules 테이블)에서 이루어진다 — 판정 기준이 바뀌어도 에이전트를
재배포할 필요가 없다.
"""
import argparse
import configparser
import hashlib
import json
import os
import random
import re
import shutil
import signal
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request

CONFIG_PATH = "/etc/kavis-agent/config.ini"
MAX_ITEM_BYTES = 190_000  # 서버 측 200KB 제한보다 여유를 둔다
TIMEOUT_SECONDS = 20
DEFAULT_INTERVAL_SECONDS = 3600  # 데몬 모드 기본 수집 주기 (1시간)
DEFAULT_JITTER_SECONDS = 300     # 여러 서버가 한꺼번에 몰리지 않도록 무작위로 더해지는 지연

# ── FIM(파일 무결성 모니터링) ─────────────────────────
# auditd(커널 감사 서브시스템)로 지정된 디렉토리를 워치해서 생성/삭제/내용변경/권한변경을 잡는다.
# 판정(정상/이상)은 서버가 하므로, 에이전트는 그 사이 쌓인 auditd 이벤트 원문만 넘긴다.
FIM_AUDIT_KEY = "kavis_fim"
FIM_RULES_PATH = "/etc/audit/rules.d/kavis-agent-fim.rules"
FIM_CHECKPOINT_PATH = "/etc/kavis-agent/.fim_checkpoint"
FIM_SERVER_DIRS_PATH = "/etc/kavis-agent/.fim_watch_dirs.json"  # 서버가 내려준 감시 경로 캐시
FIM_INITIAL_LOOKBACK_SECONDS = 3600  # 체크포인트가 없는 최초 실행 시, 과거 전체가 아니라 최근 1시간만
DEFAULT_FIM_INTERVAL_SECONDS = 180   # FIM 전용 주기 — 패키지/dnf 등 무거운 전체 수집과 분리 (상용 FIM 제품군의
                                      # 폴링 주기(수 분 단위)와 비슷한 수준. 완전 실시간은 아니지만 근접한 지연)
FIM_HASH_MAX_BYTES = 5 * 1024 * 1024  # 이보다 큰 파일은 해시하지 않는다(매 주기 큰 파일 통째로 읽는 부하 방지)


def log(msg: str) -> None:
    print(f"[kavis-agent] {msg}", file=sys.stderr, flush=True)


def read_config() -> dict:
    cp = configparser.ConfigParser()
    if not cp.read(CONFIG_PATH):
        log(f"설정 파일을 읽을 수 없습니다: {CONFIG_PATH}")
        sys.exit(1)
    if "agent" not in cp:
        log("설정 파일에 [agent] 섹션이 없습니다.")
        sys.exit(1)
    section = cp["agent"]
    server_url = section.get("server_url", "").rstrip("/")
    token = section.get("token", "").strip()
    enroll_key = section.get("enroll_key", "").strip()
    if not server_url or (not token and not enroll_key):
        log("server_url이 비어있거나, token/enroll_key가 둘 다 비어있습니다. "
            "/etc/kavis-agent/config.ini 를 확인하세요.")
        sys.exit(1)
    return {
        "server_url": server_url,
        "token": token,
        "enroll_key": enroll_key,
        "verify_tls": section.getboolean("verify_tls", fallback=True),
        "timeout": section.getint("timeout", fallback=TIMEOUT_SECONDS),
    }


def make_ssl_context(url: str, verify_tls: bool):
    if url.startswith("https://") and not verify_tls:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        return ctx
    return None


def enroll(config: dict) -> str:
    """공용 등록 키로 자산을 자동 등록하고, 발급받은 전용 토큰을 설정 파일에 저장한다."""
    url = f"{config['server_url']}/api/agent/enroll.php"
    payload = {"hostname": socket.gethostname()}
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        method="POST",
        headers={
            "Authorization": f"Bearer {config['enroll_key']}",
            "Content-Type": "application/json",
            "User-Agent": "kavis-agent/0.8.0",
        },
    )
    ctx = make_ssl_context(url, config["verify_tls"])
    try:
        with urllib.request.urlopen(req, timeout=config["timeout"], context=ctx) as resp:
            result = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        log(f"자동 등록 실패 ({e.code}): {e.read().decode('utf-8', errors='replace')}")
        sys.exit(1)
    except urllib.error.URLError as e:
        log(f"자동 등록 연결 실패: {e.reason}")
        sys.exit(1)

    token = result.get("token", "")
    if not token:
        log(f"자동 등록 응답에 토큰이 없습니다: {result}")
        sys.exit(1)

    saved = save_token(token)
    status = "설정 파일에 저장했습니다" if saved else "설정 파일 저장에 실패했습니다 — 이번 실행에만 사용되고 다음 실행에서 다시 등록됩니다"
    log(f"자동 등록 완료 (asset_id={result.get('asset_id')}, "
        f"{'신규 생성' if result.get('created') else '기존 자산 재사용'}) — 토큰을 {status}.")
    return token


def save_token(token: str) -> bool:
    """CONFIG_PATH의 token = ... 줄만 교체한다. 없으면 [agent] 섹션 끝에 추가한다.
    실제로 저장됐는지 여부를 반환한다 — 호출자가 성공 여부를 로그에 정확히 남길 수 있도록."""
    try:
        with open(CONFIG_PATH, "r") as f:
            lines = f.readlines()
    except OSError as e:
        log(f"설정 파일을 읽을 수 없어 토큰을 저장하지 못했습니다: {e}")
        return False

    pattern = re.compile(r"^\s*token\s*=.*$")
    replaced = False
    for i, line in enumerate(lines):
        if pattern.match(line):
            lines[i] = f"token = {token}\n"
            replaced = True
            break

    if not replaced:
        for i, line in enumerate(lines):
            if line.strip() == "[agent]":
                lines.insert(i + 1, f"token = {token}\n")
                replaced = True
                break

    if not replaced:
        lines.append(f"\n[agent]\ntoken = {token}\n")

    try:
        with open(CONFIG_PATH, "w") as f:
            f.writelines(lines)
        return True
    except OSError as e:
        log(f"설정 파일에 토큰을 저장하지 못했습니다: {e}")
        return False


def cmd_configure(args) -> None:
    """비대화형으로 config.ini를 작성한다. 프로비저닝 자동화(Ansible/cloud-init 등)용.
    각 값은 --플래그 또는 KAVIS_* 환경변수로 줄 수 있다 (플래그가 우선).
    기존 파일에 [fim] 등 다른 섹션이 있으면 그대로 두고 [agent] 섹션만 갱신한다 —
    예전엔 파일을 통째로 새로 써서 수동으로 추가해둔 다른 섹션이 날아가는 문제가 있었다."""
    server_url = args.server_url or os.environ.get("KAVIS_SERVER_URL", "")
    enroll_key = args.enroll_key or os.environ.get("KAVIS_ENROLL_KEY", "")
    token = args.token or os.environ.get("KAVIS_TOKEN", "")
    verify_tls = "true" if args.verify_tls else "false"

    if not server_url:
        log("--server-url (또는 KAVIS_SERVER_URL)이 필요합니다.")
        sys.exit(2)
    if not enroll_key and not token:
        log("--enroll-key 또는 --token (혹은 해당 환경변수) 중 하나는 필요합니다.")
        sys.exit(2)

    cp = configparser.ConfigParser()
    cp.read(CONFIG_PATH)  # 파일이 없으면 빈 상태로 시작 — 있으면 [fim] 등 다른 섹션은 그대로 남는다
    cp["agent"] = {
        "server_url": server_url.rstrip("/"),
        "enroll_key": enroll_key,
        "token": token,
        "verify_tls": verify_tls,
        "timeout": str(args.timeout),
    }

    try:
        with open(CONFIG_PATH, "w") as f:
            cp.write(f)
        os.chmod(CONFIG_PATH, 0o640)
    except OSError as e:
        log(f"설정 파일을 쓰지 못했습니다: {e}")
        sys.exit(1)

    log(f"{CONFIG_PATH} 작성 완료.")


def run_cmd(args: list, timeout: int = 30) -> str:
    try:
        result = subprocess.run(
            args, capture_output=True, text=True, timeout=timeout, check=False,
            stdin=subprocess.DEVNULL,  # 절대 대화형 프롬프트에서 멈추지 않도록
        )
        return result.stdout
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        log(f"명령 실행 실패 ({' '.join(args)}): {e}")
        return ""


def read_file(path: str) -> str:
    try:
        with open(path, "r", errors="replace") as f:
            return f.read()
    except OSError as e:
        log(f"파일 읽기 실패 ({path}): {e}")
        return ""


def truncate(text: str) -> str:
    data = text.encode("utf-8", errors="replace")
    if len(data) <= MAX_ITEM_BYTES:
        return text
    return data[:MAX_ITEM_BYTES].decode("utf-8", errors="ignore")


def save_fim_watch_dirs(dirs) -> None:
    """서버(관리자 페이지에서 설정, ingest.php 응답으로 전달)가 내려준 FIM 감시 경로 목록을
    로컬에 캐시한다. 다음 사이클부터는 이 값이 config.ini의 [fim] watch_dirs보다 우선한다."""
    if not isinstance(dirs, list):
        return
    clean = [d for d in dirs if isinstance(d, str) and d]
    try:
        with open(FIM_SERVER_DIRS_PATH, "w") as f:
            json.dump(clean, f)
    except OSError as e:
        log(f"[FIM] 서버 감시 경로 캐시 저장 실패: {e}")


def read_fim_watch_dirs() -> list:
    """FIM 감시 대상 디렉토리 목록을 가져온다.
    서버가 한 번이라도 응답을 준 적 있으면(캐시 파일 존재) 그 값이 우선이다 — 서버가 빈 목록을
    내려준 경우도 그대로 존중한다(더 이상 감시하지 말라는 명시적 신호). 캐시가 아직 없는
    최초 부트스트랩 구간에서만 config.ini의 [fim] watch_dirs를 폴백으로 쓴다."""
    dirs = None
    if os.path.exists(FIM_SERVER_DIRS_PATH):
        try:
            cached = json.loads(read_file(FIM_SERVER_DIRS_PATH))
            if isinstance(cached, list):
                dirs = [d for d in cached if isinstance(d, str)]
        except (ValueError, TypeError):
            dirs = None

    if dirs is None:
        cp = configparser.ConfigParser()
        raw = ""
        if cp.read(CONFIG_PATH) and "fim" in cp:
            raw = cp["fim"].get("watch_dirs", "").strip()
        dirs = [d.strip() for d in raw.split(",") if d.strip()] if raw else []

    result = []
    for d in dirs:
        if not os.path.isdir(d):
            log(f"[FIM] 감시 대상 디렉토리가 없어 건너뜁니다: {d}")
            continue
        result.append(d)
    return result


def sync_fim_rules(dirs: list) -> bool:
    """지정된 디렉토리에 대한 auditd 워치 규칙을 (재)적용한다. auditd가 없으면 조용히 건너뛴다."""
    if not shutil.which("auditctl") or not shutil.which("augenrules"):
        log("[FIM] auditd가 설치되어 있지 않아 파일 무결성 모니터링을 건너뜁니다 (dnf install audit 필요).")
        return False

    rules = "\n".join(f"-w {d} -p wa -k {FIM_AUDIT_KEY}" for d in dirs) + "\n"
    existing = read_file(FIM_RULES_PATH) if os.path.exists(FIM_RULES_PATH) else ""
    if existing == rules:
        return True  # 이미 반영돼 있음 — 매번 재적재할 필요 없음

    try:
        with open(FIM_RULES_PATH, "w") as f:
            f.write(rules)
    except OSError as e:
        log(f"[FIM] 감시 규칙 작성 실패: {e}")
        return False

    run_cmd(["augenrules", "--load"], timeout=30)
    log(f"[FIM] 감시 규칙 적용: {', '.join(dirs)}")
    return True


def read_fim_checkpoint() -> float:
    if os.path.exists(FIM_CHECKPOINT_PATH):
        try:
            return float(read_file(FIM_CHECKPOINT_PATH).strip())
        except ValueError:
            pass
    return time.time() - FIM_INITIAL_LOOKBACK_SECONDS


def write_fim_checkpoint(ts: float) -> None:
    try:
        with open(FIM_CHECKPOINT_PATH, "w") as f:
            f.write(str(ts))
    except OSError as e:
        log(f"[FIM] 체크포인트 저장 실패: {e}")


_fim_checkpoint_pending = None  # collect()에서 조회 시각을 잠깐 들고 있다가, send() 성공 후에만 커밋한다
                                 # (전송 실패 시 그 구간 이벤트를 잃어버리지 않고 다음 주기에 다시 조회하기 위함)


def collect_fim_events() -> str:
    """직전 체크포인트 이후 auditd에 쌓인 kavis_fim 이벤트 원문(ausearch -i)을 가져온다."""
    global _fim_checkpoint_pending

    dirs = read_fim_watch_dirs()
    if not dirs or not sync_fim_rules(dirs):
        return ""

    since = read_fim_checkpoint()
    now = time.time()
    # ausearch -ts는 날짜/시간을 한 문자열("MM/DD/YYYY HH:MM:SS")로 주면 "Hour, Minute, and
    # Second are required" 오류를 낸다 — 반드시 날짜와 시간을 별개의 인자 두 개로 나눠 줘야 한다.
    local = time.localtime(since)
    date_str = time.strftime("%m/%d/%Y", local)
    time_str = time.strftime("%H:%M:%S", local)
    raw = run_cmd(["ausearch", "-k", FIM_AUDIT_KEY, "-ts", date_str, time_str, "-i"], timeout=30)
    _fim_checkpoint_pending = now  # 조회에 성공했으니, 이 시각 이후만 다음번에 다시 물어보면 된다

    if not raw.strip() or "no matches" in raw.lower():
        return ""
    return raw


def compute_fim_hashes(raw_events: str) -> dict:
    """FIM 이벤트 원문에 등장한 파일 경로들의 '지금 이 순간' SHA-256을 계산해 넘긴다.
    판정(직전 값과 비교해서 진짜 바뀐 건지)은 서버가 한다 — 원칙 그대로 에이전트는 사실(현재
    해시값)만 전달하고, 노이즈 억제를 위한 비교·판단은 서버의 베이스라인 테이블이 담당한다."""
    paths = set()
    for m in re.finditer(r'\bname=("([^"]*)"|(/\S*))', raw_events):
        val = m.group(2) if m.group(2) is not None else m.group(3)
        if val and val.startswith("/"):
            paths.add(val)

    hashes = {}
    for p in paths:
        try:
            if not os.path.isfile(p) or os.path.getsize(p) > FIM_HASH_MAX_BYTES:
                continue
            h = hashlib.sha256()
            with open(p, "rb") as f:
                h.update(f.read())
            hashes[p] = h.hexdigest()
        except OSError:
            continue  # 그 사이 삭제됐거나 권한 문제 — 이번 파일만 건너뜀
    return hashes


def commit_fim_checkpoint() -> None:
    """전송이 실제로 성공했을 때만 호출 — 실패하면 다음 주기가 같은 구간을 다시 조회한다."""
    global _fim_checkpoint_pending
    if _fim_checkpoint_pending is not None:
        write_fim_checkpoint(_fim_checkpoint_pending)
        _fim_checkpoint_pending = None


def collect() -> dict:
    items = {}

    sshd = read_file("/etc/ssh/sshd_config")
    if sshd:
        items["sshd_config"] = truncate(sshd)

    os_release = read_file("/etc/os-release")
    if os_release:
        items["os_release"] = truncate(os_release)

    packages = run_cmd(["rpm", "-qa", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n"])
    if packages:
        items["packages"] = truncate(packages)

    ports = run_cmd(["ss", "-tlnp"])
    if ports:
        items["listening_ports"] = truncate(ports)

    passwd = read_file("/etc/passwd")
    if passwd:
        items["passwd"] = truncate(passwd)

    # /etc/shadow는 내용이 아니라 권한·소유자만 — 해시도 유출 가능한 비밀값이라 절대 원문을 가져오지 않는다
    shadow_perm = run_cmd(["stat", "-c", "%a %U:%G %n", "/etc/shadow", "/etc/passwd"])
    if shadow_perm:
        items["shadow_perm"] = truncate(shadow_perm)

    login_defs = read_file("/etc/login.defs")
    if login_defs:
        items["login_defs"] = truncate(login_defs)

    pwquality_conf = read_file("/etc/security/pwquality.conf")
    if pwquality_conf:
        items["pwquality_conf"] = truncate(pwquality_conf)

    cron_parts = []
    for p in ("/etc/cron.allow", "/etc/cron.deny"):
        c = read_file(p)
        if c:
            cron_parts.append(f"# {p}\n{c}")
    root_crontab = run_cmd(["crontab", "-l", "-u", "root"])
    if root_crontab:
        cron_parts.append(f"# root crontab\n{root_crontab}")
    if cron_parts:
        items["cron_config"] = truncate("\n\n".join(cron_parts))

    # dnf가 없는 배포판(예: 구형 yum 계열)은 조용히 건너뛴다.
    # 저장소 메타데이터가 캐시되지 않은 첫 실행은 시간이 오래 걸릴 수 있어 타임아웃을 넉넉히 둔다.
    dnf_updates = run_cmd(
        ["dnf", "-y", "-q", "updateinfo", "list", "security", "--installed"], timeout=180
    )
    if dnf_updates:
        items["dnf_security_updates"] = truncate(dnf_updates)

    fim_events = collect_fim_events()
    fim_hashes = {}
    if fim_events:
        items["fim_events"] = truncate(fim_events)
        fim_hashes = compute_fim_hashes(fim_events)

    return {
        "agent_version": "0.8.0",
        "hostname": socket.gethostname(),
        "items": items,
        "inventory": collect_inventory(),
        "fim_hashes": fim_hashes,
    }


def _to_int(s):
    try:
        return int(re.sub(r"\D", "", s or ""))
    except (ValueError, TypeError):
        return None


def collect_inventory() -> dict:
    """자산 인벤토리(식별/OS/하드웨어/네트워크) — 취약점 판정과 무관한 단순 사실 수집.
    판정이 아니라 사실 추출이므로, 원문이 아니라 구조화된 값으로 보낸다."""
    inv = {"fqdn": socket.getfqdn()}

    # ── 네트워크 ──
    ifaces, all_ips, all_macs = [], [], []
    ip_json = run_cmd(["ip", "-j", "addr", "show"])
    if ip_json:
        try:
            for link in json.loads(ip_json):
                name = link.get("ifname")
                if name == "lo":
                    continue
                mac = link.get("address")
                ips = [a["local"] for a in link.get("addr_info", []) if a.get("family") == "inet"]
                if mac:
                    all_macs.append(mac)
                all_ips.extend(ips)
                ifaces.append({"name": name, "mac": mac, "ips": ips})
        except (json.JSONDecodeError, KeyError, TypeError, AttributeError):
            pass
    inv["network_interfaces"] = ifaces
    inv["ip_addresses"] = all_ips
    inv["mac_addresses"] = all_macs

    dns_servers, domain = [], None
    for line in read_file("/etc/resolv.conf").splitlines():
        line = line.strip()
        if line.startswith("nameserver"):
            parts = line.split()
            if len(parts) >= 2:
                dns_servers.append(parts[1])
        elif (line.startswith("domain") or line.startswith("search")) and not domain:
            parts = line.split()
            if len(parts) >= 2:
                domain = parts[1]
    inv["dns_servers"] = dns_servers
    inv["domain"] = domain

    # ── 식별 (UUID) ──
    uuid = read_file("/sys/class/dmi/id/product_uuid").strip() or read_file("/etc/machine-id").strip()
    inv["machine_uuid"] = uuid or None

    # ── OS ──
    os_info = {}
    for line in read_file("/etc/os-release").splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            os_info[k.strip()] = v.strip().strip('"')
    inv["os_name"] = os_info.get("PRETTY_NAME") or os_info.get("NAME")
    inv["os_version"] = os_info.get("VERSION_ID") or os_info.get("VERSION")
    inv["os_arch"] = run_cmd(["uname", "-m"]).strip() or None
    inv["kernel_version"] = run_cmd(["uname", "-r"]).strip() or None

    # ── 하드웨어 (dmidecode -- 없거나 권한 부족하면 조용히 None) ──
    def dmi(field):
        v = run_cmd(["dmidecode", "-s", field]).strip()
        return v if v and not v.startswith("#") else None

    inv["manufacturer"] = dmi("system-manufacturer")
    inv["model"] = dmi("system-product-name")
    inv["serial_number"] = dmi("system-serial-number")
    inv["bios_version"] = dmi("bios-version")

    cpu_model = cpu_count = core_count = None
    for line in run_cmd(["lscpu"]).splitlines():
        if line.startswith("Model name:"):
            cpu_model = line.split(":", 1)[1].strip()
        elif line.startswith("Socket(s):"):
            cpu_count = _to_int(line.split(":", 1)[1])
        elif line.startswith("CPU(s):") and core_count is None:
            core_count = _to_int(line.split(":", 1)[1])
    inv["cpu_model"] = cpu_model
    inv["cpu_count"] = cpu_count
    inv["cpu_core_count"] = core_count

    mem_total_kb = None
    for line in read_file("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            mem_total_kb = _to_int(line.split(":", 1)[1])
            break
    inv["memory_mb"] = (mem_total_kb // 1024) if mem_total_kb else None

    disk_gb = None
    for line in run_cmd(["df", "-BG", "--total", "-x", "tmpfs", "-x", "devtmpfs"]).splitlines():
        if line.startswith("total"):
            parts = line.split()
            if len(parts) >= 2:
                disk_gb = _to_int(parts[1])

    inv["disk_total_gb"] = disk_gb

    virt = run_cmd(["systemd-detect-virt"]).strip()
    inv["virtualization_type"] = "physical" if virt == "none" else (virt or None)

    return inv


def send(config: dict, payload: dict) -> dict:
    """전송하고, 서버 응답 JSON을 파싱해 돌려준다(예: fim_watch_dirs 반영에 사용).
    파싱 실패해도 전송 자체는 이미 성공(200)한 것이므로 빈 dict를 반환할 뿐 실패로 취급하지 않는다."""
    url = f"{config['server_url']}/api/agent/ingest.php"
    data = json.dumps(payload).encode("utf-8")

    req = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {config['token']}",
            "Content-Type": "application/json",
            "User-Agent": "kavis-agent/0.8.0",
        },
    )

    ctx = make_ssl_context(url, config["verify_tls"])

    try:
        with urllib.request.urlopen(req, timeout=config["timeout"], context=ctx) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            log(f"전송 성공 ({resp.status}): {body}")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        log(f"서버 응답 오류 ({e.code}): {body}")
        sys.exit(1)
    except urllib.error.URLError as e:
        log(f"연결 실패: {e.reason}")
        sys.exit(1)

    try:
        result = json.loads(body)
    except (ValueError, TypeError):
        return {}
    if "fim_watch_dirs" in result:
        save_fim_watch_dirs(result["fim_watch_dirs"])
    return result


def cmd_run(_args) -> None:
    """1회 수집 후 종료 — 수동 테스트/디버깅용. 상시 운영은 'daemon'을 쓴다."""
    config = read_config()
    if not config["token"]:
        config["token"] = enroll(config)

    payload = collect()
    log(f"{len(payload['items'])}개 항목 수집 완료, 전송 중...")
    send(config, payload)
    commit_fim_checkpoint()


def send_fim_only(config: dict) -> None:
    """FIM 전용 짧은 주기 — 패키지/dnf 등 무거운 전체 수집은 건드리지 않고 FIM 이벤트만 확인해 보낸다.
    새 이벤트가 없으면 아예 전송하지 않는다(매번 빈 요청을 보낼 필요 없음)."""
    fim_events = collect_fim_events()
    if not fim_events:
        return
    payload = {
        "agent_version": "0.8.0",
        "hostname": socket.gethostname(),
        "items": {"fim_events": truncate(fim_events)},
        "fim_hashes": compute_fim_hashes(fim_events),
    }
    log("[FIM] 새 이벤트 감지, 전송 중...")
    send(config, payload)
    commit_fim_checkpoint()


_shutdown = False


def _handle_shutdown_signal(signum, frame) -> None:
    global _shutdown
    _shutdown = True


def cmd_daemon(args) -> None:
    """상주 프로세스로 실행하며, 내부에서 자체적으로 두 가지 주기를 돌린다.
    - 전체 수집(패키지/dnf/포트/인벤토리 등, 무거움): --interval 마다
    - FIM 이벤트만: --fim-interval 마다 (Qualys FIM 등 상용 제품의 폴링 주기와 비슷한 수준)
    systemd Type=simple 서비스로 등록되어 ps/pstree/systemctl status에 항상 보인다."""
    signal.signal(signal.SIGTERM, _handle_shutdown_signal)
    signal.signal(signal.SIGINT, _handle_shutdown_signal)

    log(f"데몬 모드 시작 (전체 수집 주기={args.interval}초, 지터=0~{args.jitter}초, "
        f"FIM 전용 주기={args.fim_interval}초)")

    next_full = 0.0  # 0으로 두면 시작하자마자 첫 전체 수집을 바로 한 번 돈다
    next_fim = 0.0

    while not _shutdown:
        now = time.time()
        try:
            config = read_config()
            if not config["token"]:
                config["token"] = enroll(config)

            if now >= next_full:
                payload = collect()  # FIM도 이 안에 포함되므로 전체 수집 시엔 FIM 전용 주기를 따로 안 돈다
                log(f"{len(payload['items'])}개 항목 수집 완료, 전송 중...")
                send(config, payload)
                commit_fim_checkpoint()
                next_full = now + args.interval + random.randint(0, max(args.jitter, 0))
                next_fim = now + args.fim_interval
            elif now >= next_fim:
                send_fim_only(config)
                next_fim = now + args.fim_interval
        except SystemExit:
            log("이번 주기 실행에 실패했습니다 — 다음 주기에 다시 시도합니다.")
            next_fim = max(next_fim, time.time() + args.fim_interval)
        except Exception as e:  # noqa: BLE001 - 데몬은 어떤 예외에도 죽지 않고 다음 주기를 기다려야 한다
            log(f"예상치 못한 오류로 이번 주기를 건너뜁니다: {e}")
            next_fim = max(next_fim, time.time() + args.fim_interval)

        if _shutdown:
            break
        time.sleep(1)

    log("종료 신호를 받아 데몬을 종료합니다.")


def main() -> None:
    parser = argparse.ArgumentParser(prog="kavis-agent")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("run", help="1회 수집 후 종료 (수동 테스트용)")

    p_daemon = sub.add_parser("daemon", help="상주 실행하며 자체 주기로 수집 (systemd 서비스가 호출)")
    p_daemon.add_argument("--interval", type=int, default=DEFAULT_INTERVAL_SECONDS)
    p_daemon.add_argument("--jitter", type=int, default=DEFAULT_JITTER_SECONDS)
    p_daemon.add_argument("--fim-interval", dest="fim_interval", type=int, default=DEFAULT_FIM_INTERVAL_SECONDS)

    p_conf = sub.add_parser("configure", help="config.ini를 비대화형으로 작성 (프로비저닝 자동화용)")
    p_conf.add_argument("--server-url", default="")
    p_conf.add_argument("--enroll-key", default="")
    p_conf.add_argument("--token", default="")
    p_conf.add_argument("--timeout", type=int, default=TIMEOUT_SECONDS)
    p_conf.add_argument("--verify-tls", dest="verify_tls", action="store_true", default=True)
    p_conf.add_argument("--no-verify-tls", dest="verify_tls", action="store_false")

    args = parser.parse_args()
    {"run": cmd_run, "daemon": cmd_daemon, "configure": cmd_configure}[args.command](args)


if __name__ == "__main__":
    main()
