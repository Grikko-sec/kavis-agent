[agent]
server_url = https://kavis.example.com

; ── 둘 중 하나만 채우면 됩니다 ─────────────────────────
; A) 자동 등록: 관리자 페이지 > 에이전트 자동 등록 에서 발급받은 공용 키.
;    최초 실행 시 호스트명으로 자산이 자동 생성되고, 발급받은 전용 토큰이
;    이 파일의 token 항목에 자동으로 채워집니다. 이후에는 token만 쓰입니다.
enroll_key =

; B) 수동 발급: 관리자 페이지 > 자산 상세 > 에이전트 연동 에서 이 자산 전용으로
;    직접 발급받은 토큰. 채워져 있으면 enroll_key는 무시됩니다.
token =

; server_url이 https이고 사설 인증서를 쓰는 경우에만 false로 설정
verify_tls = true

; 서버 응답 대기 시간(초)
timeout = 20

; ── FIM(파일 무결성 모니터링, 선택) ───────────────────
; 0.7.0부터 감시 경로는 관리자 페이지(자산 상세 > FIM 감시 경로 설정)에서 지정하는 게
; 기본 방식입니다 — 서버가 한 번이라도 응답을 준 뒤로는 이 아래 watch_dirs는 무시됩니다.
; 여기 값은 서버에 아직 한 번도 연결하지 못한 최초 부트스트랩 구간에서만 쓰이는 폴백입니다.
; auditd가 설치돼 있어야 동작한다(dnf install audit).
[fim]
watch_dirs =
