[Unit]
Description=Kavis platform collection agent (daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kavis-agent daemon
User=root
# 프로세스가 죽더라도(예상치 못한 예외 등) systemd가 다시 띄운다.
Restart=always
RestartSec=30
# 정지 요청(SIGTERM) 후 데몬이 1초 주기로 스스로 확인하고 빠르게 종료하므로 넉넉할 필요 없다.
TimeoutStopSec=15
# 설정 파일 읽기(root-owned) 및 sshd_config 등 시스템 설정 수집을 위해 root로 실행한다.
# dnf가 /var/cache/dnf에 락/캐시를 쓰므로 ProtectSystem은 full(=/etc,/usr,/boot만 보호)로 둔다.
ProtectSystem=full
# 자동등록 시 토큰을 config.ini에 저장해야 하므로, ProtectSystem=full의 /etc 읽기전용 예외로 이 경로를 허용한다.
# /etc/audit는 FIM 워치 규칙(augenrules --load가 rules.d/audit.rules에 씀)을 위해 함께 허용한다.
# FIM(watch_dirs)이 /home 밑을 감시할 수도 있으니 true(=완전히 안 보임) 대신 read-only로 둔다 —
# 여전히 /home에 쓰기는 막히지만, 존재 여부 확인·auditctl 워치 대상 지정은 가능해야 한다.
ReadWritePaths=/etc/kavis-agent /etc/audit
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
# 운영 서비스와 CPU를 경쟁하지 않도록 우선순위를 낮추고 상한을 건다.
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M

[Install]
WantedBy=multi-user.target
